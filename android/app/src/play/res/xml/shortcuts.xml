<?xml version="1.0" encoding="utf-8"?>
<!-- Ярлыки для варианта play: пакет amber.liner (класс MainActivity остаётся в app.yantar.player) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_launcher_fg"
        android:shortcutId="smartmix"
        android:shortcutShortLabel="@string/shortcut_mix">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="yantar://action/smartmix"
            android:targetClass="app.yantar.player.MainActivity"
            android:targetPackage="amber.liner" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_launcher_fg"
        android:shortcutId="resume"
        android:shortcutShortLabel="@string/shortcut_resume">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="yantar://action/resume"
            android:targetClass="app.yantar.player.MainActivity"
            android:targetPackage="amber.liner" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_launcher_fg"
        android:shortcutId="radio"
        android:shortcutShortLabel="@string/shortcut_radio">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="yantar://action/radio"
            android:targetClass="app.yantar.player.MainActivity"
            android:targetPackage="amber.liner" />
    </shortcut>
</shortcuts>
