{
  "name": "yantar",
  "private": true,
  "version": "0.12.2",
  "description": "Amber — личный офлайн-плеер для Android и компьютера",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "sync": "npm run build && cap sync android",
    "apk": "npm run sync && node android/gradle.mjs assembleSiteDebug",
    "aab": "vue-tsc -b && vite build --mode play && cap sync android && node android/gradle.mjs bundlePlayRelease",
    "site": "node site/pack.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src tests server/src server/test",
    "desktop:build": "npm run build && node desktop/build.mjs",
    "desktop": "npm run desktop:build && electron desktop/app",
    "desktop:start": "electron desktop/app",
    "desktop:pack": "npm run desktop:build && electron-builder --win --config desktop/electron-builder.json",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^15.0.0",
    "comlink": "^4.4.2",
    "date-fns": "^4.4.0",
    "kysely": "^0.29.6",
    "minisearch": "^7.2.0",
    "pinia": "^4.0.3",
    "sql.js": "^1.14.2",
    "vosk-browser": "^0.0.8",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/solar": "^1.2.12",
    "@types/node": "^22.20.4",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
