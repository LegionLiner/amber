# Скопируй в .env и поменяй пароль. Файл .env в git не попадает.

# Пароль базы — только латиница и цифры (он входит в адрес подключения).
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Можно ли создавать новые аккаунты. Заведи свой — и поставь false (потом: docker compose up -d)
ALLOW_SIGNUP=true

# Код приглашения: если задан, без него зарегистрироваться нельзя
SIGNUP_CODE=

# Порт на сервере (только 127.0.0.1), куда nginx проксирует запросы
AMBER_PORT=8096
