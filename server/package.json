{
  "name": "amber-server",
  "private": true,
  "version": "0.2.0",
  "description": "Amber — сервер синхронизации: аккаунты и данные между телефоном и компьютером",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
